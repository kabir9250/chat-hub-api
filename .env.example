NODE_ENV=development
PORT=3001

# MongoDB Atlas connection string. Replace <password> with the real database
# user password (get it from the Atlas dashboard) — never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.dubtmpk.mongodb.net/zendesk?appName=Cluster0

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d

# Origin allowed to call the API / open the WebSocket (chat-hub-web dev server).
CORS_ORIGIN=http://localhost:3000

# AttributionService's geolocation cascade (see that file's doc comment):
# ipgeolocation.io -> ipapi.co -> ip-api.com -> self-hosted MaxMind (final
# fallback). GEO_FALLBACK_ENABLED gates the 3 online tiers as a group; set
# to false for a fully offline/sandboxed environment with no outbound
# internet access (goes straight to the MaxMind local DB). Never used for
# private/loopback IPs regardless.
GEO_FALLBACK_ENABLED=true
# Per-tier timeout for each online lookup, in ms.
GEO_LOOKUP_TIMEOUT_MS=2000

# Tier 1 — ipgeolocation.io. Free API key at ipgeolocation.io/signup
# (30,000 req/month free tier). Tier 1 is skipped (falls through to tier 2)
# when this is unset.
IPGEOLOCATION_API_KEY=

# Tier 4 (final fallback) — self-hosted MaxMind GeoLite2-City database. Free
# account+license key at maxmind.com (My Account > Manage License Keys).
# MAXMIND_ACCOUNT_ID is only used for logging by `npm run geoip:update`, not
# for auth — the license key alone authenticates the download.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Run `npm run geoip:update` after setting the above to fetch/refresh
# geo-data/GeoLite2-City.mmdb. Schedule it periodically (weekly is enough —
# MaxMind republishes GeoLite2 about that often) via Windows Task Scheduler
# in dev, cron/systemd timer on the VPS in production.

# Phase 2 §3.9 — Attachments object storage. Local-disk stand-in for now
# (see PROGRESS.md "Object storage" entry) — files are written under
# UPLOADS_DIR, organized <siteId>/<conversationId>/<uuid>.<ext>. Swapping to
# a real S3-compatible bucket (AWS S3 / Cloudflare R2 / Backblaze B2) later
# only requires a new StorageService implementation, not a rewrite of any
# caller.
UPLOADS_DIR=./uploads
# The origin this API is actually reachable at — used to build the absolute
# signed URLs the Widget/Agent Console load attachments from.
PUBLIC_API_BASE_URL=http://localhost:3001
# Signs/verifies short-lived attachment links (FR-P2-ATT-08) — same
# "never ship the placeholder to production" rule as JWT_SECRET.
ATTACHMENTS_SIGNING_SECRET=dev-attachments-secret-change-me
# How long a signed attachment link stays valid, in seconds.
ATTACHMENT_SIGNED_URL_TTL_SECONDS=300

# §6.3 business decision (PROGRESS.md, Session Fix-11) — per-IP multi-session
# abuse guard (IpVisitorIdentityGuardService), SEPARATE from and independent
# of the per-Visitor-identity message cap. If more than this many DISTINCT
# Visitor identities send messages / start a session from one IP within the
# rolling window below, the next new one is throttled. 3/5min is a
# deliberately generous starting point (tolerates a shared office/school/
# cafe network) based on reasoned judgment, not a verified industry-standard
# number — tune from real post-launch traffic, no code change needed.
IP_VISITOR_IDENTITY_MAX=3
IP_VISITOR_IDENTITY_WINDOW_MS=300000
