NODE_ENV=test
# Different from the dev server's PORT (3001) so a temporary test-run
# instance never collides with an already-running dev `npm run start:dev`.
PORT=3011

# MongoDB Atlas connection string — MUST point at a dedicated TEST database
# name (containing "test"), never the dev/prod database. `seed-test.ts`
# refuses to run otherwise. Same cluster as dev is fine (a separate
# database name within it is enough isolation) — see
# apps/files/reports/README.md "Which database" section.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.dubtmpk.mongodb.net/zendesk_test?appName=Cluster0

JWT_SECRET=test-secret-change-me
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:3002

UPLOADS_DIR=./uploads-test
PUBLIC_API_BASE_URL=http://localhost:3011
ATTACHMENTS_SIGNING_SECRET=test-attachments-secret-change-me
ATTACHMENT_SIGNED_URL_TTL_SECONDS=300
